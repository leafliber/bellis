{
  "name": "live",
  "packs": [
    {
      "name": "obs",
      "entries": [
        {
          "id": "obs",
          "plugin": "obs-control",
          "grant": ["obs.control"]
        }
      ]
    },
    {
      "name": "stage",
      "entries": [
        {
          "id": "stage-page",
          "plugin": "stage-page-obs",
          "grant": ["obs.stage-url"]
        },
        {
          "id": "stage",
          "plugin": "stage-service"
        },
        {
          "id": "stage-sync",
          "plugin": "stage-sync",
          "grant": ["obs.meters"]
        }
      ]
    },
    {
      "name": "avatar",
      "entries": [
        {
          "id": "avatar",
          "plugin": "avatar-vts",
          "grant": ["secret:vts"],
          "config": {
            "url": "ws://127.0.0.1:8001",
            "expressions": {}
          }
        }
      ]
    },
    {
      "name": "moderation",
      "entries": [
        {
          "id": "moderation",
          "plugin": "moderation",
          "disabled": true
        }
      ]
    },
    {
      "name": "speech",
      "entries": [
        {
          "id": "review",
          "plugin": "speech-review",
          "config": {
            "delayMs": 3000
          }
        },
        {
          "id": "tts",
          "plugin": "tts-router",
          "config": {
            "order": ["local", "subtitles"]
          }
        },
        {
          "id": "tts-local",
          "plugin": "tts-local",
          "config": {
            "backend": "qwen3",
            "qwen3": {
              "speaker": "vivian",
              "language": "chinese"
            }
          }
        },
        {
          "id": "tts-cloud",
          "plugin": "tts-cloud",
          "disabled": true,
          "grant": [
            "net.egress:api.minimax.cn",
            "net.egress:openspeech.bytedance.com",
            "secret:minimax",
            "secret:volcengine"
          ],
          "config": {
            "primary": "minimax",
            "fallback": ["volcengine"],
            "minimax": {
              "egress": false,
              "endpoint": "wss://api.minimax.cn/ws/v1/t2a_v2_bidi",
              "model": "speech-2.8-turbo",
              "voiceId": "",
              "sampleRate": 24000,
              "languageBoost": "Chinese"
            },
            "volcengine": {
              "egress": false,
              "endpoint": "wss://openspeech.bytedance.com/api/v3/tts/bidirection",
              "resourceId": "seed-tts-2.0",
              "speaker": "",
              "sampleRate": 24000,
              "timestamps": "subtitle"
            }
          }
        }
      ]
    },
    {
      "name": "audience",
      "entries": [
        {
          "id": "danmaku",
          "plugin": "danmaku-bilibili",
          "disabled": true,
          "grant": [
            "net.egress:live-open.biliapi.com",
            "net.egress:*.chat.bilibili.com",
            "secret:bilibili",
            "secret:bilibili-code"
          ],
          "config": {
            "appId": 0
          }
        },
        {
          "id": "triage",
          "plugin": "audience-triage",
          "disabled": true
        },
        {
          "id": "vote",
          "plugin": "audience-vote",
          "disabled": true,
          "grant": ["vote.start"]
        }
      ]
    }
  ]
}
