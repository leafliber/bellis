{
  "name": "live",
  "packs": [
    {
      "name": "telemetry",
      "entries": [
        {
          "id": "telemetry",
          "plugin": "telemetry",
          "config": {
            "dir": "telemetry/live"
          }
        }
      ]
    },
    {
      "name": "obs",
      "entries": [
        {
          "id": "obs",
          "plugin": "obs-control",
          "grant": ["obs.control"]
        }
      ]
    },
    {
      "name": "stage",
      "entries": [
        {
          "id": "stage-page",
          "plugin": "stage-page-obs",
          "grant": ["obs.stage-url"]
        },
        {
          "id": "stage",
          "plugin": "stage-service"
        },
        {
          "id": "stage-sync",
          "plugin": "stage-sync",
          "grant": ["obs.meters"]
        }
      ]
    },
    {
      "name": "avatar",
      "entries": [
        {
          "id": "avatar",
          "plugin": "avatar-vts",
          "grant": ["secret:vts"],
          "config": {
            "url": "ws://127.0.0.1:8001",
            "expressions": {}
          }
        }
      ]
    },
    {
      "name": "moderation",
      "entries": [
        {
          "id": "moderation",
          "plugin": "moderation",
          "disabled": true
        }
      ]
    },
    {
      "name": "speech",
      "entries": [
        {
          "id": "speech",
          "plugin": "speech-arbiter",
          "grant": ["speech.output"]
        },
        {
          "id": "review",
          "plugin": "speech-review",
          "config": {
            "delayMs": 3000
          }
        },
        {
          "id": "tts",
          "plugin": "tts-router",
          "config": {
            "order": ["local", "subtitles"]
          }
        },
        {
          "id": "tts-local",
          "plugin": "tts-local",
          "config": {
            "backend": "qwen3",
            "qwen3": {
              "speaker": "vivian",
              "language": "chinese"
            }
          }
        },
        {
          "id": "tts-cloud",
          "plugin": "tts-cloud",
          "disabled": true,
          "grant": [
            "net.egress:api.minimax.cn",
            "net.egress:openspeech.bytedance.com",
            "secret:minimax",
            "secret:volcengine"
          ],
          "config": {
            "primary": "minimax",
            "fallback": ["volcengine"],
            "minimax": {
              "egress": false,
              "endpoint": "wss://api.minimax.cn/ws/v1/t2a_v2_bidi",
              "model": "speech-2.8-turbo",
              "voiceId": "",
              "sampleRate": 24000,
              "languageBoost": "Chinese"
            },
            "volcengine": {
              "egress": false,
              "endpoint": "wss://openspeech.bytedance.com/api/v3/tts/bidirection",
              "resourceId": "seed-tts-2.0",
              "speaker": "",
              "sampleRate": 24000,
              "timestamps": "subtitle"
            }
          }
        }
      ]
    },
    {
      "name": "interaction",
      "entries": [
        {
          "id": "danmaku",
          "plugin": "danmaku-bilibili",
          "disabled": true,
          "grant": [
            "net.egress:live-open.biliapi.com",
            "net.egress:*.chat.bilibili.com",
            "secret:bilibili",
            "secret:bilibili-code"
          ],
          "config": {
            "appId": 0
          }
        },
        {
          "id": "triage",
          "plugin": "audience-triage",
          "disabled": true
        },
        {
          "id": "vote",
          "plugin": "audience-vote",
          "disabled": true,
          "grant": ["vote.start"]
        },
        {
          "id": "llm",
          "plugin": "llm-openai",
          "disabled": true,
          "grant": ["net.egress:ark.cn-beijing.volces.com", "secret:ark"],
          "config": {
            "endpoint": "https://ark.cn-beijing.volces.com/api/v3/chat/completions",
            "model": "glm-5-3-flash-260828",
            "provider": "volcengine.ark",
            "reasoningEffort": "low",
            "outputMode": "prompt",
            "probeOnPreflight": false
          }
        },
        {
          "id": "director",
          "plugin": "director",
          "disabled": true,
          "config": {
            "persona": "你是贝莉，一位温和、爱聊天的中文虚拟主播。你说话亲切、简短、口语化，喜欢和观众聊游戏、日常和有趣的小事，会认真回应每一位观众。你不谈论真实人物、政治和宗教，也不给医疗或投资方面的建议，遇到这类话题就温和地把话题转开。你始终以贝莉的身份说话。",
            "fallback": { "lines": ["稍等，我想一想。"] }
          }
        }
      ]
    },
    {
      "name": "memory",
      "entries": [
        {
          "id": "iris",
          "plugin": "iris-client",
          "disabled": true,
          "grant": ["net.egress:127.0.0.1", "secret:iris"],
          "config": {
            "baseUrl": "http://127.0.0.1:8080",
            "egressReviewed": false
          }
        },
        {
          "id": "memory",
          "plugin": "memory",
          "disabled": true,
          "grant": ["memory.write"],
          "config": {
            "entryId": "",
            "entryName": "直播间",
            "selfName": "（示例：角色名，由操作员改写）",
            "recall": { "judge": false, "memoryLimit": 5 }
          }
        }
      ]
    }
  ]
}
