{
  "name": "live",
  "packs": [
    {
      "name": "obs",
      "entries": [
        {
          "id": "obs",
          "plugin": "obs-control",
          "grant": ["obs.control"]
        }
      ]
    },
    {
      "name": "stage",
      "entries": [
        {
          "id": "stage-page",
          "plugin": "stage-page-obs",
          "grant": ["obs.stage-url"]
        },
        {
          "id": "stage",
          "plugin": "stage-service"
        }
      ]
    },
    {
      "name": "avatar",
      "entries": [
        {
          "id": "avatar",
          "plugin": "avatar-vts",
          "grant": ["secret:vts"],
          "config": {
            "url": "ws://127.0.0.1:8001",
            "expressions": {}
          }
        }
      ]
    },
    {
      "name": "moderation",
      "entries": [
        {
          "id": "moderation",
          "plugin": "moderation",
          "disabled": true
        }
      ]
    },
    {
      "name": "speech",
      "entries": [
        {
          "id": "review",
          "plugin": "speech-review",
          "config": {
            "delayMs": 3000
          }
        }
      ]
    }
  ]
}
