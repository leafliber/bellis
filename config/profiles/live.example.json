{
  "name": "live",
  "packs": [
    {
      "name": "obs",
      "entries": [
        {
          "id": "obs",
          "plugin": "obs-control",
          "grant": ["obs.control"]
        }
      ]
    },
    {
      "name": "stage",
      "entries": [
        {
          "id": "stage-page",
          "plugin": "stage-page-obs",
          "grant": ["obs.stage-url"]
        },
        {
          "id": "stage",
          "plugin": "stage-service"
        }
      ]
    },
    {
      "name": "moderation",
      "entries": [
        {
          "id": "moderation",
          "plugin": "moderation",
          "disabled": true
        }
      ]
    },
    {
      "name": "speech",
      "entries": [
        {
          "id": "review",
          "plugin": "speech-review",
          "config": {
            "delayMs": 3000
          }
        },
        {
          "id": "tts-cloud",
          "plugin": "tts-cloud",
          "disabled": true,
          "grant": [
            "net.egress:api.minimax.cn",
            "net.egress:openspeech.bytedance.com",
            "secret:minimax",
            "secret:volcengine"
          ],
          "config": {
            "primary": "minimax",
            "fallback": ["volcengine", "subtitles"],
            "minimax": {
              "egress": false,
              "endpoint": "wss://api.minimax.cn/ws/v1/t2a_v2_bidi",
              "model": "speech-2.8-turbo",
              "voiceId": "",
              "sampleRate": 24000,
              "languageBoost": "Chinese"
            },
            "volcengine": {
              "egress": false,
              "endpoint": "wss://openspeech.bytedance.com/api/v3/tts/bidirection",
              "resourceId": "seed-tts-2.0",
              "speaker": "",
              "sampleRate": 24000,
              "timestamps": "subtitle"
            }
          }
        },
        {
          "id": "tts-local",
          "plugin": "tts-local",
          "disabled": true,
          "config": {
            "backend": "fake",
            "fake": {
              "toneHz": 440
            }
          }
        }
      ]
    }
  ]
}
