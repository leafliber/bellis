{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": false,
    "types": ["node"]
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts", "tools/**/*.ts", "contracts/generated/**/*.ts", "contracts/generated/**/*.mts"]
}
