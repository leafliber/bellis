{
  "name": "bellis",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "check": "pnpm run lint && pnpm run typecheck && pnpm run gen:check && pnpm run test",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "gen": "node packages/protocol/scripts/gen.ts",
    "gen:check": "node packages/protocol/scripts/gen.ts --check",
    "test": "node --test \"packages/*/test/**/*.test.ts\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "fast-check": "4.10.2",
    "typescript": "7.0.2"
  }
}
