{
  "name": "bellis",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "11.11.0"
  },
  "scripts": {
    "generate": "node tools/generate.ts",
    "check": "node tools/generate.ts --check && node tools/check.ts && pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "node --test tests/*.test.ts",
    "gate": "node tools/gate.ts",
    "spike:sqlite": "node tools/spikes/sqlite.mjs",
    "spike:browser": "node tools/spikes/browser.mjs",
    "spike:serve": "node tools/spikes/probe-server.mjs",
    "acceptance:p0:tools": "node tools/acceptance/run.ts",
    "p0:supervisor": "node apps/host/supervisor.ts",
    "p0:operator": "node apps/host/operator.ts",
    "p0:install": "node tools/p0-install.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.5",
    "ajv": "8.20.0",
    "better-sqlite3": "13.0.3",
    "esbuild": "0.28.2",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2"
  }
}
