# macOS
.DS_Store

# 检查、探针与运行输出：每次运行重写，不入库
/reports/

# 本地配置与凭据（示例文件用 .env.example，只放脱敏占位值）
.env
.env.*
!.env.example

# 真实配置：从 *.example.json 复制，不入库；仓库只带 sim 配置与样例
/config/*.json
!/config/sim.json
!/config/*.example.json
/config/profiles/*.json
!/config/profiles/sim.json
!/config/profiles/*.example.json
# 仓库只带整体启用互动包、记忆包的 patch（不含任何值）；维护者自己的 patch 可能带真实值，不入库
/config/patches/*.json
!/config/patches/interaction.json
!/config/patches/memory.json

# Node / Python 工具
node_modules/
dist/
.cache/
.pnpm-store/
__pycache__/
.venv/
.ruff_cache/
.pytest_cache/

# 本机运行数据（状态存储等）
/.bellis/
