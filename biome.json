{
  "files": {
    "includes": [
      "apps/**",
      "plugins/**",
      "!plugins/fake-device/generated/endpoint.mjs",
      "!plugins/fake-device/generated/manifest.json",
      "packages/**",
      "tests/**",
      "tools/**/*.ts",
      "tools/**/*.mjs"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
