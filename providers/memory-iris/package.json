{
  "name": "@iris-memory/bellis-provider",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bellis MemoryProvider and PersonaSource adapter for Iris Memory Core",
  "engines": {
    "node": ">=26.5 <27"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "compatibility-matrix.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "lint": "oxlint src test",
    "format:check": "oxfmt --check src test vitest.config.ts"
  },
  "dependencies": {
    "@bellis/contracts": "link:../../packages/contracts",
    "@iris-memory/sdk": "^0.11.1"
  },
  "devDependencies": {
    "@bellis/testkit": "link:../../packages/testkit",
    "@types/node": "26.2.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@bellis/contracts": "^0.1.0"
  }
}
