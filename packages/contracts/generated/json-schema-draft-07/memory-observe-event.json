{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "outboxId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "agentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "spaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "spaceGroupId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "tool",
        "system",
        "external"
      ]
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "occurredAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "committedAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sourceStream": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceCursor": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,29})$"
    },
    "effectState": {
      "type": "string",
      "enum": [
        "committed",
        "partial"
      ]
    },
    "effectApplied": {
      "type": "boolean"
    },
    "content": {
      "type": "string"
    },
    "structuredPayload": {
      "type": "object",
      "properties": {},
      "additionalProperties": {
        "$ref": "#/definitions/__schema0"
      }
    },
    "privacyLabels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "effectProof": {
      "type": "object",
      "properties": {},
      "additionalProperties": {
        "$ref": "#/definitions/__schema0"
      }
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "outboxId",
    "agentId",
    "role",
    "kind",
    "occurredAtMs",
    "committedAtMs",
    "effectState"
  ],
  "additionalProperties": {
    "$ref": "#/definitions/__schema0"
  },
  "definitions": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/definitions/__schema0"
          }
        }
      ]
    }
  }
}
