{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "payloadVersion": {
      "type": "number",
      "const": 1
    },
    "batchId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "watermarkFrom": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,29})$"
    },
    "watermarkTo": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,29})$"
    },
    "trigger": {
      "type": "string",
      "enum": [
        "deadline",
        "count",
        "token_budget",
        "byte_budget",
        "urgent_bypass",
        "close"
      ]
    },
    "messageCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "urgentCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tokenEstimate": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "payloadVersion",
    "batchId",
    "watermarkFrom",
    "watermarkTo",
    "trigger",
    "messageCount",
    "urgentCount",
    "tokenEstimate"
  ],
  "additionalProperties": {
    "$ref": "#/definitions/__schema0"
  },
  "definitions": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/definitions/__schema0"
          }
        }
      ]
    }
  }
}
