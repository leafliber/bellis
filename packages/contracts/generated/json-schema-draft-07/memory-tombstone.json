{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "providerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "resourceRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "throughRevision": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,29})$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "providerId",
    "resourceRef",
    "throughRevision"
  ],
  "additionalProperties": false
}
