{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "scene": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "sceneId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "cycleId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "groups": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "number",
                "const": 1
              },
              "groupId": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "lanes": {
                "minItems": 1,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "audio",
                    "subtitle",
                    "avatar",
                    "game",
                    "overlay"
                  ]
                }
              },
              "level": {
                "type": "string",
                "enum": [
                  "hard",
                  "soft",
                  "detached"
                ]
              }
            },
            "required": [
              "schemaVersion",
              "groupId",
              "lanes",
              "level"
            ],
            "additionalProperties": {
              "$ref": "#/definitions/__schema0"
            }
          }
        },
        "deadlineMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "interruptPolicy": {
          "type": "string",
          "enum": [
            "finish",
            "fade",
            "immediate"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "sceneId",
        "cycleId",
        "groups",
        "deadlineMs",
        "interruptPolicy"
      ],
      "additionalProperties": {
        "$ref": "#/definitions/__schema0"
      }
    },
    "cues": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "number",
            "const": 1
          },
          "cueId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "lane": {
            "type": "string",
            "enum": [
              "audio",
              "subtitle",
              "avatar",
              "game",
              "overlay"
            ]
          },
          "anchor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "offsetMs": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "intent": {
            "$ref": "#/definitions/__schema0"
          }
        },
        "required": [
          "schemaVersion",
          "cueId",
          "lane",
          "anchor",
          "offsetMs",
          "intent"
        ],
        "additionalProperties": {
          "$ref": "#/definitions/__schema0"
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "scene",
    "cues"
  ],
  "additionalProperties": {
    "$ref": "#/definitions/__schema0"
  },
  "definitions": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/definitions/__schema0"
          }
        }
      ]
    }
  }
}
