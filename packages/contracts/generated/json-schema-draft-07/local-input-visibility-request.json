{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "policy": {
      "type": "object",
      "properties": {
        "scopeKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "scopeKey",
        "generation"
      ],
      "additionalProperties": false
    },
    "batchRange": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,29})$"
        },
        "to": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,29})$"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "signalIds": {
      "maxItems": 164,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      }
    },
    "toolRuns": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "toolRunId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "toolName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "toolRunId",
          "toolName"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "sessionId",
    "policy",
    "signalIds",
    "toolRuns"
  ],
  "additionalProperties": false
}
