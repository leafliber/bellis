{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
        },
        "messageId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "trace": {
          "type": "object",
          "properties": {
            "traceId": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "spanId": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            }
          },
          "required": [
            "traceId"
          ],
          "additionalProperties": false
        },
        "sentAtUs": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,29})$"
        },
        "deadlineUs": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,29})$"
        },
        "payload": {},
        "direction": {
          "type": "string",
          "const": "server"
        },
        "seq": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,29})$"
        }
      },
      "required": [
        "version",
        "type",
        "messageId",
        "sessionId",
        "trace",
        "sentAtUs",
        "payload",
        "direction",
        "seq"
      ],
      "additionalProperties": {}
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
        },
        "messageId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "trace": {
          "type": "object",
          "properties": {
            "traceId": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "spanId": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            }
          },
          "required": [
            "traceId"
          ],
          "additionalProperties": false
        },
        "sentAtUs": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,29})$"
        },
        "deadlineUs": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,29})$"
        },
        "payload": {},
        "direction": {
          "type": "string",
          "const": "client"
        },
        "ack": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,29})$"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "version",
        "type",
        "messageId",
        "sessionId",
        "trace",
        "sentAtUs",
        "payload",
        "direction"
      ],
      "additionalProperties": {}
    }
  ]
}
