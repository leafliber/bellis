{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "signalId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "sequence": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,29})$"
    },
    "priorityClass": {
      "type": "string",
      "enum": [
        "normal",
        "urgent"
      ]
    },
    "receivedAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "signal": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "occurredAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "payload": {
          "$ref": "#/definitions/__schema0"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "kind",
        "source",
        "occurredAt",
        "priority",
        "payload"
      ],
      "additionalProperties": {
        "$ref": "#/definitions/__schema0"
      }
    }
  },
  "required": [
    "schemaVersion",
    "signalId",
    "sequence",
    "priorityClass",
    "receivedAtMs",
    "signal"
  ],
  "additionalProperties": {
    "$ref": "#/definitions/__schema0"
  },
  "definitions": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/definitions/__schema0"
          }
        }
      ]
    }
  }
}
