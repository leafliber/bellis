{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "hardLanes": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "audio",
          "subtitle",
          "avatar",
          "game",
          "overlay"
        ]
      }
    },
    "softTimeoutMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "hardLanes"
  ],
  "additionalProperties": false
}
