      "pattern": "^(?:0|[1-9][0-9]{0,29})$"
    },
    "contentHash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "policyMode": {
      "type": "string",
      "enum": [
        "locked",
        "manual",
        "bounded_auto"
      ]
    },
    "core": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/definitions/__schema0"
      }
    },
    "traits": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/definitions/__schema0"
      }
    },
    "narrative": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/definitions/__schema0"
      }
    },
    "state": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "fields": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "$ref": "#/definitions/__schema0"
              }
            },
            "baseline": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "$ref": "#/definitions/__schema0"
              }
            },
            "expiresAt": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "fields",
            "baseline",
            "expiresAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "effectiveFrom": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "fetchedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "origin": {
      "type": "string",
      "enum": [
        "live",
        "verified-cache",
        "static-fallback"
      ]
    }
  },
  "required": [
    "agentId",
    "revision",
    "contentHash",
    "policyMode",
    "core",
    "traits",
    "narrative",
    "state",
