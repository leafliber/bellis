{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "outboxId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "partitionKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "payload": {},
    "createdAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "outboxId",
    "topic",
    "partitionKey",
    "payload",
    "createdAtMs"
  ],
  "additionalProperties": false
}
