{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "intentId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "motion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expression": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "channels": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "head",
          "eyes",
          "body",
          "mouth",
          "expression"
        ]
      }
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "fadeInMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "fadeOutMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "interruptible": {
      "type": "boolean"
    },
    "exclusive": {
      "type": "boolean"
    },
    "mutexTags": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    }
  },
  "required": [
    "schemaVersion",
    "intentId",
    "channels",
    "priority",
    "durationMs",
    "interruptible",
    "exclusive",
    "mutexTags"
  ],
  "additionalProperties": false
}
