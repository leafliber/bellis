{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "segmentId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "cueId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "lane": {
      "type": "string",
      "enum": [
        "audio",
        "subtitle"
      ]
    },
    "start": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    },
    "end": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    },
    "textHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "segmentId",
    "cueId",
    "lane",
    "start",
    "end",
    "textHash"
  ],
  "additionalProperties": false
}
