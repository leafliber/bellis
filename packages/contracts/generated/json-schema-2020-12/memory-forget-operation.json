{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "toolRunId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "scopeKey": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "preparedDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "barrierGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "state": {
      "type": "string",
      "enum": [
        "blocked",
        "resolved",
        "retained"
      ]
    },
    "receipt": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "targetCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "erasedCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "protectedSkipped": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "heldSkipped": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "requestId",
            "targetCount",
            "erasedCount",
            "protectedSkipped",
            "heldSkipped"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "sessionId",
    "toolRunId",
    "scopeKey",
    "preparedDigest",
    "barrierGeneration",
    "state",
    "receipt"
  ],
  "additionalProperties": false
}
