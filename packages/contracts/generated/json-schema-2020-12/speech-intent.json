{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "purpose": {
      "type": "string",
      "enum": [
        "answer",
        "tool_notice",
        "aside",
        "reaction"
      ]
    },
    "interruptible": {
      "type": "boolean"
    },
    "emotion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "required": [
    "schemaVersion",
    "text",
    "purpose",
    "interruptible"
  ],
  "additionalProperties": {}
}
