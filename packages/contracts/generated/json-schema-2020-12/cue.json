{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "cueId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "lane": {
      "type": "string",
      "enum": [
        "audio",
        "subtitle",
        "avatar",
        "game",
        "overlay"
      ]
    },
    "anchor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "offsetMs": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "intent": {}
  },
  "required": [
    "schemaVersion",
    "cueId",
    "lane",
    "anchor",
    "offsetMs",
    "intent"
  ],
  "additionalProperties": false
}
