{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "server.hello"
        },
        "payload": {
          "type": "object",
          "properties": {
            "protocolVersion": {
              "type": "number",
              "const": 1
            },
            "runtimeVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "heartbeatIntervalMs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 600000
            },
            "replayWindowSize": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100000
            }
          },
          "required": [
            "protocolVersion",
            "runtimeVersion",
            "heartbeatIntervalMs",
            "replayWindowSize"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "client.hello"
        },
        "payload": {
          "type": "object",
          "properties": {
            "protocolVersion": {
              "type": "number",
              "const": 1
            },
            "clientType": {
              "type": "string",
              "enum": [
                "studio",
                "stage",
                "overlay",
                "test-client"
              ]
            },
            "lastAck": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,29})$"
            }
          },
          "required": [
            "protocolVersion",
            "clientType"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "server.ready"
        },
        "payload": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "heartbeat.ping"
        },
        "payload": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "heartbeat.pong"
        },
        "payload": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "clock.ping"
        },
        "payload": {
          "type": "object",
          "properties": {
            "c0": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,29})$"
            }
          },
          "required": [
            "c0"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "clock.pong"
        },
        "payload": {
          "type": "object",
          "properties": {
            "c0": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,29})$"
            },
            "r1": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,29})$"
            },
            "r2": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,29})$"
            }
          },
          "required": [
            "c0",
            "r1",
            "r2"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "session.snapshot"
        },
        "payload": {
          "type": "object",
          "properties": {
            "snapshot": {
              "type": "object",
              "properties": {
                "schemaVersion": {
                  "type": "number",
                  "const": 1
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "initial",
                    "replay_gap",
                    "requested"
                  ]
                },
                "sessionId": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                },
                "sessionStatus": {
                  "type": "string",
                  "enum": [
                    "starting",
                    "ready",
                    "draining"
                  ]
                },
                "latestServerSeq": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,29})$"
                },
                "signalWatermarks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "watermark": {
                        "type": "string",
                        "pattern": "^(?:0|[1-9][0-9]{0,29})$"
                      }
                    },
                    "required": [
                      "source",
                      "watermark"
                    ],
                    "additionalProperties": false
                  }
                },
                "lastCommittedScene": {
                  "type": "object",
                  "properties": {
                    "sceneId": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    },
                    "cycleId": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    },
                    "status": {
                      "type": "string",
                      "const": "committed"
                    },
                    "committedAtMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "sceneId",
                    "cycleId",
                    "status",
                    "committedAtMs"
                  ],
                  "additionalProperties": false
                },
                "activeScene": {
                  "type": "null"
                },
                "openMediaStreams": {
                  "maxItems": 0,
                  "type": "array",
                  "items": {}
                },
                "runtimeVersion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "generatedAtMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "schemaVersion",
                "reason",
                "sessionId",
                "sessionStatus",
                "latestServerSeq",
                "signalWatermarks",
                "activeScene",
                "openMediaStreams",
                "runtimeVersion",
                "generatedAtMs"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "snapshot"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "scene.prepared"
        },
        "payload": {
          "type": "object",
          "properties": {
            "sceneId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "cycleId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "cues": {
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "cueId": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  },
                  "lane": {
                    "type": "string",
                    "enum": [
                      "audio",
                      "subtitle",
                      "avatar",
                      "game",
                      "overlay"
                    ]
                  }
                },
                "required": [
                  "cueId",
                  "lane"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "sceneId",
            "cycleId",
            "cues"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "scene.committed"
        },
        "payload": {
          "type": "object",
          "properties": {
            "sceneId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "cycleId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "committedAtMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "sceneId",
            "cycleId",
            "committedAtMs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "scene.cancelled"
        },
        "payload": {
          "type": "object",
          "properties": {
            "sceneId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "cycleId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "sceneId",
            "cycleId",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "media.stream.open"
        },
        "payload": {
          "type": "object",
          "properties": {
            "streamId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "mediaKind": {
              "type": "string",
              "enum": [
                "audio",
                "viseme",
                "binary-test"
              ]
            },
            "contentType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "streamId",
            "mediaKind",
            "contentType"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "media.stream.closed"
        },
        "payload": {
          "type": "object",
          "properties": {
            "streamId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "streamId",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "payload": {
          "type": "object",
          "properties": {
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "invalid_message",
                    "unsupported_version",
                    "unauthorized",
                    "deadline_exceeded",
                    "backpressure",
                    "not_ready",
                    "internal_error"
                  ]
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "retryable": {
                  "type": "boolean"
                },
                "details": {},
                "traceId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                }
              },
              "required": [
                "code",
                "message",
                "retryable",
                "traceId"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "error"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "payload"
      ],
      "additionalProperties": false
    }
  ]
}
