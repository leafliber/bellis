{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "turnId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "cycleId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "cycleIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxCyclesPerTurn": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "batch": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "watermarkFrom": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,29})$"
        },
        "watermarkTo": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,29})$"
        },
        "highlights": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "signalId": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "userId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "signalId",
              "userId",
              "text"
            ],
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "topics": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "participants": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "examples": {
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            },
            "required": [
              "label",
              "count",
              "participants",
              "examples"
            ],
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "urgentSignals": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "number",
                "const": 1
              },
              "id": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "occurredAt": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "payload": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "required": [
              "schemaVersion",
              "id",
              "kind",
              "source",
              "occurredAt",
              "priority",
              "payload"
            ],
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "tokenEstimate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "watermarkFrom",
        "watermarkTo",
        "highlights",
        "topics",
        "urgentSignals",
        "tokenEstimate"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "pendingToolResults": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "number",
            "const": 1
          },
          "toolRunId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "toolName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "outcome": {
            "type": "string",
            "enum": [
              "succeeded",
              "failed",
              "dependency_failed",
              "timeout",
              "cancelled",
              "denied"
            ]
          },
          "value": {
            "$ref": "#/$defs/__schema0"
          },
          "errorCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "truncated": {
            "type": "boolean"
          },
          "cacheSource": {
            "type": "string",
            "enum": [
              "l0",
              "l1",
              "l2"
            ]
          }
        },
        "required": [
          "schemaVersion",
          "toolRunId",
          "toolName",
          "outcome",
          "truncated"
        ],
        "additionalProperties": {
          "$ref": "#/$defs/__schema0"
        }
      }
    },
    "recentSpeech": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "number",
            "const": 1
          },
          "cycleId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "purpose": {
            "type": "string",
            "enum": [
              "answer",
              "tool_notice",
              "aside",
              "reaction"
            ]
          }
        },
        "required": [
          "schemaVersion",
          "cycleId",
          "text",
          "purpose"
        ],
        "additionalProperties": {
          "$ref": "#/$defs/__schema0"
        }
      }
    },
    "toolResultsTruncated": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "turnId",
    "cycleId",
    "cycleIndex",
    "maxCyclesPerTurn",
    "batch",
    "pendingToolResults",
    "recentSpeech",
    "toolResultsTruncated"
  ],
  "additionalProperties": {
    "$ref": "#/$defs/__schema0"
  },
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
