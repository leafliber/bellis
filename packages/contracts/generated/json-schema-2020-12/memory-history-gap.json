{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "providerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "agentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "gapId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reason": {
      "type": "string",
      "enum": [
        "history_unavailable",
        "checkpoint_missing"
      ]
    },
    "cursor": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,29})$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^[!-~]{1,512}$"
    }
  },
  "required": [
    "schemaVersion",
    "providerId",
    "agentId",
    "gapId",
    "reason",
    "cursor"
  ],
  "additionalProperties": false
}
