{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "intentId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "skillId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "timeRelation": {
      "type": "string",
      "enum": [
        "at_scene_start",
        "at_speech_word",
        "after_speech",
        "independent"
      ]
    },
    "wordIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "arguments": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "schemaVersion",
    "intentId",
    "skillId",
    "timeRelation",
    "arguments"
  ],
  "additionalProperties": false
}
