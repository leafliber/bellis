{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "policy": {
      "type": "object",
      "properties": {
        "scopeKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "scopeKey",
        "generation"
      ],
      "additionalProperties": false
    },
    "providerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "agentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "spaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "coreSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "actorExternalIdentityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceStream": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "external"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "privacyLabels": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  },
  "required": [
    "providerId",
    "agentId",
    "spaceId",
    "actorExternalIdentityId",
    "sourceStream",
    "role",
    "content",
    "privacyLabels"
  ],
  "additionalProperties": false
}
