{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "plan": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "effects": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "sessionId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "connectionGeneration": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "contentHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "textLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65536
            },
            "segments": {
              "minItems": 1,
              "maxItems": 32,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "segmentId": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  },
                  "cueId": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  },
                  "lane": {
                    "type": "string",
                    "enum": [
                      "audio",
                      "subtitle"
                    ]
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65536
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65536
                  },
                  "textHash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "segmentId",
                  "cueId",
                  "lane",
                  "start",
                  "end",
                  "textHash"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "schemaVersion",
            "sessionId",
            "connectionGeneration",
            "contentHash",
            "textLength",
            "segments"
          ],
          "additionalProperties": false
        },
        "scene": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "sceneId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "cycleId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "groups": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "schemaVersion": {
                    "type": "number",
                    "const": 1
                  },
                  "groupId": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  },
                  "lanes": {
                    "minItems": 1,
                    "maxItems": 8,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "audio",
                        "subtitle",
                        "avatar",
                        "game",
                        "overlay"
                      ]
                    }
                  },
                  "level": {
                    "type": "string",
                    "enum": [
                      "hard",
                      "soft",
                      "detached"
                    ]
                  }
                },
                "required": [
                  "schemaVersion",
                  "groupId",
                  "lanes",
                  "level"
                ],
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              }
            },
            "deadlineMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "interruptPolicy": {
              "type": "string",
              "enum": [
                "finish",
                "fade",
                "immediate"
              ]
            }
          },
          "required": [
            "schemaVersion",
            "sceneId",
            "cycleId",
            "groups",
            "deadlineMs",
            "interruptPolicy"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "cues": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "number",
                "const": 1
              },
              "cueId": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "lane": {
                "type": "string",
                "enum": [
                  "audio",
                  "subtitle",
                  "avatar",
                  "game",
                  "overlay"
                ]
              },
              "anchor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "offsetMs": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "intent": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "required": [
              "schemaVersion",
              "cueId",
              "lane",
              "anchor",
              "offsetMs",
              "intent"
            ],
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "softTimeoutMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      },
      "required": [
        "schemaVersion",
        "scene",
        "cues"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "targets": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "policy": {
            "type": "object",
            "properties": {
              "scopeKey": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "generation": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "scopeKey",
              "generation"
            ],
            "additionalProperties": false
          },
          "providerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "agentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "spaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "coreSessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sourceStream": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "privacyLabels": {
            "minItems": 1,
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "required": [
          "providerId",
          "agentId",
          "spaceId",
          "sourceStream",
          "privacyLabels"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "plan",
    "targets"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
