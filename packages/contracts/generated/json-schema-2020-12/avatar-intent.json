          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "head",
              "eyes",
              "body",
              "mouth",
              "expression"
            ]
          }
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fadeInMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fadeOutMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "interruptible": {
          "type": "boolean"
        },
        "exclusive": {
          "type": "boolean"
        },
        "mutexTags": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
