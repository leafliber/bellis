{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "occurredAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "payload": {}
  },
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "source",
    "occurredAt",
    "priority",
    "payload"
  ],
  "additionalProperties": false
}
