{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bellis:schema:game-bridge-v2",
  "$defs": {
    "GameDescribeVersion": {
      "type": "object",
      "required": [
        "major"
      ],
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "GameDescribeParams": {
      "type": "object",
      "required": [
        "major"
      ],
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "additionalProperties": false
    },
    "GameMainDescriptionV2": {
      "type": "object",
      "required": [
        "major",
        "runtimeId",
        "nowMs",
        "adapter",
        "prerequisites",
        "controlTargetId"
      ],
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2
        },
        "runtimeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "nowMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709
        },
        "adapter": {
          "type": "object",
          "required": [
            "id",
            "version",
            "screenTypes"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,47}$"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "screenTypes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "base"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "base": {
                    "enum": [
                      "对话",
                      "选择",
                      "计时选择",
                      "菜单",
                      "设置",
                      "存读档",
                      "商店",
                      "加载",
                      "过场",
                      "即时玩法",
                      "地图",
                      "背包",
                      "坏结局",
                      "卡住",
                      "未知"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "maxItems": 64
            }
          },
          "additionalProperties": false
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text",
              "confirmed"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "confirmed": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "maxItems": 64
        },
        "controlTargetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "GameAck": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "GameGoalSubmitParamsV2": {
      "type": "object",
      "required": [
        "goalId",
        "objective",
        "constraints",
        "mode",
        "decisionPointId",
        "expiresAtMs",
        "traceparent",
        "taskId"
      ],
      "properties": {
        "goalId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "maxItems": 16
        },
        "mode": {
          "enum": [
            "autonomous",
            "waiting_vote",
            "paused",
            "manual"
          ]
        },
        "decisionPointId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expiresAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709
        },
        "traceparent": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "taskId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "GameTaskOpenParams": {
      "type": "object",
      "required": [
        "taskId",
        "objective",
        "expiresAtMs",
        "overallCompletion"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "expiresAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709
        },
        "overallCompletion": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "kind",
                    "signature"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "signature"
                      ]
                    },
                    "signature": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "kind",
                    "screenType"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "screen"
                      ]
                    },
                    "screenType": {
                      "enum": [
                        "对话",
                        "选择",
                        "计时选择",
                        "菜单",
                        "设置",
                        "存读档",
                        "商店",
                        "加载",
                        "过场",
                        "即时玩法",
                        "地图",
                        "背包",
                        "坏结局",
                        "卡住",
                        "未知"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "kind",
                    "text",
                    "roi"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "text-appeared",
                        "text-disappeared"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    },
                    "roi": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "GameTaskOpenResult": {
      "type": "object",
      "required": [
        "taskId"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "GameActionResolveOutcomeParams": {
      "type": "object",
      "required": [
        "sessionId",
        "attemptId",
        "resolution"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "resolution": {
          "enum": [
            "confirmed_executed",
            "confirmed_not_executed",
            "reconciled_unknown"
          ]
        }
      },
      "additionalProperties": false
    },
    "GameActionResolveOutcomeResult": {
      "type": "object",
      "required": [
        "attemptId",
        "resolution"
      ],
      "properties": {
        "attemptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "resolution": {
          "enum": [
            "confirmed_executed",
            "confirmed_not_executed",
            "reconciled_unknown"
          ]
        }
      },
      "additionalProperties": false
    },
    "GameDecisionResolveParams": {
      "type": "object",
      "required": [
        "decisionPointId",
        "optionId",
        "source",
        "traceparent"
      ],
      "properties": {
        "decisionPointId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "optionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "source": {
          "enum": [
            "director",
            "vote"
          ]
        },
        "traceparent": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "GamePacingHoldParams": {
      "type": "object",
      "required": [
        "holdId",
        "reason",
        "expiresAtMs",
        "traceparent"
      ],
      "properties": {
        "holdId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expiresAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709
        },
        "traceparent": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "GamePacingReleaseParams": {
      "type": "object",
      "required": [
        "holdId",
        "traceparent"
      ],
      "properties": {
        "holdId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "traceparent": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "GameSituationObserved": {
      "type": "object",
      "required": [
        "atMs",
        "screenType",
        "screenTypeExtension",
        "summary",
        "currentLine",
        "interactables",
        "lookpoints",
        "voiceActivity",
        "rereading",
        "failure",
        "traceparent"
      ],
      "properties": {
        "atMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709
        },
        "screenType": {
          "enum": [
            "对话",
            "选择",
            "计时选择",
            "菜单",
            "设置",
            "存读档",
            "商店",
            "加载",
            "过场",
            "即时玩法",
            "地图",
            "背包",
            "坏结局",
            "卡住",
            "未知"
          ]
        },
        "screenTypeExtension": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "currentLine": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "interactables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "maxItems": 32
        },
        "lookpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "summary",
              "importance",
              "atMs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
              },
              "kind": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$"
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "importance": {
                "enum": [
                  "medium",
                  "high"
                ]
              },
              "atMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709
              }
            },
            "additionalProperties": false
          },
          "maxItems": 16
        },
        "voiceActivity": {
          "enum": [
            "busy",
            "idle",
            "unknown"
          ]
        },
        "rereading": {
          "type": "boolean"
        },
        "failure": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "source",
                "summary"
              ],
              "properties": {
                "source": {
                  "anyOf": [
                    {
                      "enum": [
                        "director",
                        "vote",
                        "default"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "traceparent": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "GameDecisionPointOpened": {
      "type": "object",
      "required": [
        "decisionPointId",
        "atMs",
        "prompt",
        "options",
        "candidates",
        "timing",
        "traceparent"
      ],
      "properties": {
        "decisionPointId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "atMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 360
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            },
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 64
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "optionId",
              "rank",
              "reason",
              "citation",
              "previousFailure"
            ],
            "properties": {
              "optionId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
              },
              "rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "citation": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "previousFailure": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "source",
                      "summary"
                    ],
                    "properties": {
                      "source": {
                        "anyOf": [
                          {
                            "enum": [
                              "director",
                              "vote",
                              "default"
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "summary": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "maxItems": 64
        },
        "timing": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "resolveByMs",
                "deadlineMs"
              ],
              "properties": {
                "resolveByMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709
                },
                "deadlineMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "traceparent": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "GameActionCommitted": {
      "type": "object",
      "required": [
        "actionId",
        "atMs",
        "goalId",
        "category",
        "summary",
        "selection",
        "traceparent"
      ],
      "properties": {
        "actionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "atMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709
        },
        "goalId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "category": {
          "enum": [
            "advance",
            "navigate",
            "select"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "selection": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "decisionPointId",
                "optionId",
                "source"
              ],
              "properties": {
                "decisionPointId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
                },
                "optionId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
                },
                "source": {
                  "enum": [
                    "director",
                    "vote",
                    "default"
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "traceparent": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "GameMainHealthV2": {
      "type": "object",
      "required": [
        "atMs",
        "ready",
        "mode",
        "goalId",
        "decisionPointId",
        "prerequisites",
        "firstActionMs",
        "frameAgeMs",
        "queueDepth",
        "riskScore",
        "riskLimitExceeded",
        "lastRejection",
        "pendingActionOutcome",
        "activeTaskId"
      ],
      "properties": {
        "atMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709
        },
        "ready": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "autonomous",
            "waiting_vote",
            "paused",
            "manual"
          ]
        },
        "goalId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "decisionPointId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text",
              "confirmed"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "confirmed": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "maxItems": 64
        },
        "firstActionMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        },
        "frameAgeMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        },
        "queueDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "riskScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "riskLimitExceeded": {
          "type": "boolean"
        },
