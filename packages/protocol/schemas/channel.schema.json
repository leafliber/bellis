{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bellis:schema:channel",
  "$defs": {
    "ChannelHello": {
      "type": "object",
      "required": [
        "v",
        "type",
        "role",
        "nonce"
      ],
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "hello"
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{0,63}$"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "additionalProperties": false
    },
    "ChannelChallenge": {
      "type": "object",
      "required": [
        "v",
        "type",
        "nonce",
        "proof"
      ],
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "challenge"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "proof": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "additionalProperties": false
    },
    "ChannelProof": {
      "type": "object",
      "required": [
        "v",
        "type",
        "proof"
      ],
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "proof"
        },
        "proof": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "additionalProperties": false
    },
    "ChannelAccept": {
      "type": "object",
      "required": [
        "v",
        "type"
      ],
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "accept"
        }
      },
      "additionalProperties": false
    }
  }
}
