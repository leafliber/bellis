{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bellis:schema:process",
  "$defs": {
    "SessionInfo": {
      "type": "object",
      "required": [
        "v",
        "sessionId",
        "channelPath",
        "channelKey",
        "launcherPid",
        "startedAt"
      ],
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[a-z0-9]{1,16}$"
        },
        "channelPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260
        },
        "channelKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "launcherPid": {
          "type": "integer",
          "minimum": 1
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "ProcessShutdownParams": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "ProcessShutdownResult": {
      "type": "object",
      "required": [
        "accepted"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "HostStoppingParams": {
      "type": "object",
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "HostStatusResult": {
      "type": "object",
      "required": [
        "watchdogConnected"
      ],
      "properties": {
        "watchdogConnected": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "HostHeartbeatParams": {
      "type": "object",
      "required": [
        "seq",
        "mode",
        "maintenance"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "type": "string"
        },
        "maintenance": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "OperatorModeParams": {
      "type": "object",
      "required": [
        "target"
      ],
      "properties": {
        "target": {
          "anyOf": [
            {
              "type": "string",
              "const": "M0"
            },
            {
              "type": "string",
              "const": "M1"
            },
            {
              "type": "string",
              "const": "M2"
            },
            {
              "type": "string",
              "const": "M3"
            },
            {
              "type": "string",
              "const": "safe-stop"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "OperatorEmergencyParams": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "OperatorVetoParams": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "additionalProperties": false
    },
    "OperatorReleaseParams": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "additionalProperties": false
    },
    "OperatorPreflightParams": {
      "type": "object",
      "properties": {
        "target": {
          "anyOf": [
            {
              "type": "string",
              "const": "M1"
            },
            {
              "type": "string",
              "const": "M2"
            },
            {
              "type": "string",
              "const": "M3"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "OperatorForgetParams": {
      "type": "object",
      "required": [
        "account"
      ],
      "properties": {
        "account": {
          "type": "string",
          "pattern": "^[\\x21-\\x7e]{1,128}$"
        }
      },
      "additionalProperties": false
    },
    "OperatorConsoleLoginResult": {
      "type": "object",
      "required": [
        "url",
        "token",
        "expiresInMs"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^http://127\\.0\\.0\\.1:[0-9]{1,5}/$"
        },
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22,128}$"
        },
        "expiresInMs": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "WatchdogActedParams": {
      "type": "object",
      "required": [
        "reason",
        "ok",
        "actedAt"
      ],
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "const": "heartbeat-lost"
            },
            {
              "type": "string",
              "const": "connection-lost"
            }
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "actedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}
