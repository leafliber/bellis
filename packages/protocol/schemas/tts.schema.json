{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bellis:schema:tts",
  "$defs": {
    "TtsInfoResult": {
      "type": "object",
      "required": [
        "backend",
        "processes",
        "status"
      ],
      "properties": {
        "backend": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 32
        },
        "processes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "maxItems": 64
        },
        "status": {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "loading"
                },
                {
                  "type": "string",
                  "const": "ready"
                },
                {
                  "type": "string",
                  "const": "failed"
                }
              ]
            },
            "detail": {
              "type": "string",
              "maxLength": 200
            },
            "sampleRate": {
              "type": "integer",
              "minimum": 8000,
              "maximum": 48000
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "TtsStatus": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "anyOf": [
            {
              "type": "string",
              "const": "loading"
            },
            {
              "type": "string",
              "const": "ready"
            },
            {
              "type": "string",
              "const": "failed"
            }
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 200
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 48000
        }
      },
      "additionalProperties": false
    },
    "TtsSynthesizeParams": {
      "type": "object",
      "required": [
        "stream",
        "text"
      ],
      "properties": {
        "stream": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "additionalProperties": false
    },
    "TtsSynthesizeResult": {
      "type": "object",
      "required": [
        "samples"
      ],
      "properties": {
        "samples": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "TtsWordsParams": {
      "type": "object",
      "required": [
        "stream",
        "words"
      ],
      "properties": {
        "stream": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "words": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "startMs",
              "endMs"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "startMs": {
                "type": "number",
                "minimum": 0
              },
              "endMs": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "maxItems": 500
        }
      },
      "additionalProperties": false
    }
  }
}
