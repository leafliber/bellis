{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bellis:schema:plugin",
  "$defs": {
    "PluginManifest": {
      "type": "object",
      "required": [
        "id",
        "version",
        "tier",
        "provides",
        "inject",
        "permissions",
        "process",
        "config"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$",
          "maxLength": 48
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "tier": {
          "anyOf": [
            {
              "type": "string",
              "const": "critical"
            },
            {
              "type": "string",
              "const": "ordinary"
            }
          ]
        },
        "provides": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*@[0-9]+$"
          }
        },
        "inject": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*@[0-9]+\\??$"
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*(:[A-Za-z0-9.-]+)?$"
          }
        },
        "process": {
          "anyOf": [
            {
              "type": "string",
              "const": "in-process"
            },
            {
              "type": "string",
              "const": "sidecar"
            }
          ]
        },
        "config": {
          "type": "object",
          "patternProperties": {
            "^.*$": {}
          }
        }
      },
      "additionalProperties": false
    },
    "Profile": {
      "type": "object",
      "required": [
        "name",
        "packs"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$",
          "maxLength": 48
        },
        "packs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "entries"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48
              },
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "plugin"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$",
                      "maxLength": 48
                    },
                    "plugin": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$",
                      "maxLength": 48
                    },
                    "disabled": {
                      "type": "boolean"
                    },
                    "config": {},
                    "grant": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*(:[A-Za-z0-9.-]+)?$"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "ProfilePatch": {
      "type": "object",
      "required": [
        "name",
        "ops"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "ops": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "op",
                  "entry"
                ],
                "properties": {
                  "op": {
                    "type": "string",
                    "const": "replace"
                  },
                  "entry": {
                    "type": "object",
                    "required": [
                      "id",
                      "plugin"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$",
                        "maxLength": 48
                      },
                      "plugin": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$",
                        "maxLength": 48
                      },
                      "disabled": {
                        "type": "boolean"
                      },
                      "config": {},
                      "grant": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*(:[A-Za-z0-9.-]+)?$"
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "op",
                  "entry"
                ],
                "properties": {
                  "op": {
                    "type": "string",
                    "const": "insert"
                  },
                  "entry": {
                    "type": "object",
                    "required": [
                      "id",
                      "plugin"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$",
                        "maxLength": 48
                      },
                      "plugin": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$",
                        "maxLength": 48
                      },
                      "disabled": {
                        "type": "boolean"
                      },
                      "config": {},
                      "grant": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*(:[A-Za-z0-9.-]+)?$"
                        }
                      }
                    },
                    "additionalProperties": false
                  },
                  "after": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$",
                    "maxLength": 48
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "op",
                  "id"
                ],
                "properties": {
                  "op": {
                    "type": "string",
                    "const": "disable"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$",
                    "maxLength": 48
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "op",
                  "id"
                ],
                "properties": {
                  "op": {
                    "type": "string",
                    "const": "enable"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$",
                    "maxLength": 48
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "SidecarDescription": {
      "type": "object",
      "required": [
        "protocol",
        "provides",
        "permissions"
      ],
      "properties": {
        "protocol": {
          "type": "number",
          "const": 1
        },
        "provides": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*@[0-9]+$"
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*(:[A-Za-z0-9.-]+)?$"
          }
        }
      },
      "additionalProperties": false
    },
    "SidecarHealthResult": {
      "type": "object",
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "detail": {
          "type": "string",
          "maxLength": 200
        },
        "qos": {
          "anyOf": [
            {
              "type": "string",
              "const": "high"
            },
            {
              "type": "string",
              "const": "eco"
            },
            {
              "type": "string",
              "const": "default"
            },
            {
              "type": "string",
              "const": "unknown"
            },
            {
              "type": "string",
              "const": "unsupported"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
