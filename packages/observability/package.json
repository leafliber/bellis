{
  "name": "@bellis/observability",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trace、日志与指标：Gate 1 最小 Port 与 No-op，P3 交付 Pino Logger、字段级 Redaction、内存 Metrics 与 W3C Trace 上下文",
  "engines": {
    "node": ">=26.5 <27"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "oxlint src test",
    "format:check": "oxfmt --check src test"
  },
  "dependencies": {
    "@bellis/contracts": "workspace:*",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "vitest": "4.1.11"
  }
}
